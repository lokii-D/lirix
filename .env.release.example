# Copy to `.env.release` in the repo root (that file is gitignored).
# Fill with your own values — never commit `.env.release`.
#
# PyPI: API token with upload scope for project `lirix`.
PYPI_TOKEN=pypi_REPLACE_ME
#
# GitHub: classic PAT with `workflow` + `repo`, OR fine-grained PAT with
# Actions: Read and write (needed to dispatch the Release workflow).
GITHUB_TOKEN=ghp_REPLACE_ME
