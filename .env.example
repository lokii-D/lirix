# Copy to `.env` in the repo root (gitignored) before local demo or docker compose.
# Never commit secrets or `.env` itself.

# Mantle Sepolia (testnet / deployment target)
MANTLE_RPC_URLS=https://rpc.sepolia.mantle.xyz
MANTLE_SEPOLIA_RPC=https://rpc.sepolia.mantle.xyz
MANTLE_SEPOLIA_EXPLORER=https://explorer.sepolia.mantle.xyz
# Canonical explorer (Mantlescan); explorer.sepolia.mantle.xyz redirects here
MANTLE_SEPOLIA_EXPLORER_CANONICAL=https://sepolia.mantlescan.xyz

# Mantle mainnet (optional — for fork smoke / mainnet preset demos)
MANTLE_MAINNET_RPC=https://rpc.mantle.xyz

# Deployed LirixShield on Mantle Sepolia (public, no secret)
LIRIX_SHIELD_CONTRACT=0x844cd69eADcc097F759FBf76C2d9735A55A9635c

# On-chain proof transaction (Mantle Sepolia — verified)
ON_CHAIN_PROOF_TX=0xa23bb06ad14518ea7418082caef761cf864548a6705e8a2682b08c6cd69b055a
